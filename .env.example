# =============================================================================
# Salin berkas ini menjadi `.env` di root repo, lalu isi nilainya.
#   cp .env.example .env          (Mac/Linux)
#   copy .env.example .env        (Windows)
#
# JANGAN commit berkas `.env` yang sudah terisi — sudah diblokir .gitignore.
# =============================================================================

# --- Backend (opsional) ------------------------------------------------------
# Aplikasi BERJALAN PENUH tanpa kunci ini. Penyusunan itinerary, rute, peta,
# biaya, dan analisis dampak UMKM seluruhnya berbasis optimasi ILP dan tidak
# memanggil model bahasa sama sekali.
#
# Kunci ini hanya mengaktifkan dua fitur di lapisan antarmuka:
#   1. AI Search  (POST /api/ai-search)
#   2. Penerjemah (POST /api/translate, /api/translate-ui)
# Tanpa kunci, kedua endpoint tersebut membalas HTTP 400 dengan pesan yang jelas
# dan seluruh fitur lain tetap normal.
OPENAI_API_KEY=isi_dengan_api_key_openai_anda
OPENAI_MODEL_NAME=gpt-4o-mini


# --- Batas pemakaian fitur AI (opsional) -------------------------------------
# Semua punya nilai bawaan; isi hanya bila ingin mengubahnya. Angka adalah
# jumlah panggilan per jam per pemanggil. Untuk pengguna yang sudah masuk,
# ember dihitung per AKUN, bukan per IP — di belakang NAT (mis. wifi kampus
# saat penjurian) satu IP dipakai banyak orang sekaligus.
#
# Narasi dashboard boleh berkuota kecil karena hasilnya di-cache berdasarkan
# sidik jari angkanya: membuka halaman berulang kali TIDAK memakan kuota, dan
# panggilan baru hanya terjadi bila angkanya benar-benar berubah.
# RATE_INSIGHT_PER_JAM=6
# RATE_GAP_PER_JAM=6
# RATE_ADVISOR_PER_JAM=10
# RATE_SIMULASI_PER_JAM=12
# RATE_AI_SEARCH_PER_JAM=15
# RATE_TRANSLATE_PER_JAM=40
# RATE_TRANSLATE_UI_PER_JAM=12
#
# Pagu seluruh pengguna per 24 jam; 0 berarti tanpa pagu.
# RATE_PAGU_HARIAN=400


# --- Supabase: autentikasi & basis data (opsional) ---------------------------
# Tanpa variabel ini aplikasi TETAP JALAN: seluruh endpoint publik (itinerary,
# rute, peta, biaya, dampak UMKM) berfungsi normal. Yang tidak aktif hanyalah
# login dan dashboard berperan — endpoint terproteksi membalas 401/503 dengan
# pesan yang jelas, bukan diam-diam meloloskan.
SUPABASE_URL=https://siqdhypesrprbrztucxw.supabase.co

# RAHASIA. Ambil dari dashboard Supabase:
#   Project Settings -> API Keys -> service_role
# Kunci ini melewati seluruh Row Level Security, jadi HANYA boleh ada di
# server. Jangan pernah menaruhnya di berkas frontend/ atau variabel VITE_*.
SUPABASE_SERVICE_ROLE_KEY=isi_dengan_service_role_key

# Mode verifikasi tanda tangan token.
#   RS256 = kunci ASIMETRIS lewat JWKS (dianjurkan, dan yang dipakai proyek ini).
#           Nilai ini hanya saklar "mode asimetris"; kode menerima RS256 maupun
#           ES256, dan project ini sebenarnya menandatangani dengan ES256.
#   HS256 = secret simetris lama. Hanya untuk keadaan darurat bila kunci
#           asimetris belum aktif di dashboard.
SUPABASE_JWT_ALG=RS256

# HANYA diisi bila SUPABASE_JWT_ALG=HS256. Ambil dari
# Project Settings -> API -> JWT Secret (bukan "secret API key" sb_secret_...,
# keduanya berbeda dan sering tertukar). Biarkan kosong saat memakai RS256.
# SUPABASE_JWT_SECRET=

# Email yang otomatis berperan ADMIN. Diperlukan untuk memutus telur-dan-ayam:
# persetujuan peran butuh ADMIN, sedangkan ADMIN pertama belum ada.
# Pisahkan dengan koma bila lebih dari satu.
ADMIN_EMAILS=

# --- Peran GOV ditentukan oleh alamat surel, bukan persetujuan admin ---------
# Admin tidak punya cara memverifikasi klaim "saya orang dinas" yang lebih baik
# daripada domain surelnya, jadi /api/auth/klaim menolak permohonan GOV dan
# peran itu diberikan seketika saat masuk bila surelnya memenuhi salah satu
# dari dua syarat di bawah.

# 1) Daftar alamat persis yang berperan GOV. Dipakai untuk instansi yang masih
#    memakai surel umum (mis. Gmail) dan untuk juri saat demo. Pisahkan koma.
GOV_EMAILS=

# Nama lama untuk hal yang sama; masih dibaca agar konfigurasi lama tidak putus.
GOV_DEMO_EMAILS=

# 2) Domain yang otomatis berperan GOV, termasuk subdomainnya — `go.id` juga
#    mencakup `tobakab.go.id`, `sumutprov.go.id`, dan seterusnya. `go.id` hanya
#    bisa didaftarkan lembaga negara, jadi kepemilikannya sudah menjadi bukti.
#
#    JANGAN menambahkan domain uji coba di sini. Peran GOV aktif seketika tanpa
#    persetujuan siapa pun, dan GOV berwenang memverifikasi usaha UMKM — domain
#    yang bisa didaftarkan siapa saja menjadi rantai: surel demo -> GOV seketika
#    -> verifikasi usaha mana pun. Untuk demo, pakai GOV_EMAILS di atas.
#
#    Kosongkan variabel ini bila ingin memakai daftar GOV_EMAILS saja — itu mode
#    paling ketat, dan yang dianjurkan saat penjurian.
GOV_EMAIL_DOMAINS=go.id


# --- Notifikasi verifikasi usaha (opsional) ----------------------------------
# Ketika klaim usaha disetujui, dinas kabupaten diberi tahu bahwa ada usaha
# menunggu verifikasi identitas. Pemberitahuan SELALU tercatat di tabel
# `notifikasi_gov` dan selalu terbaca di dashboard pemerintah; variabel di bawah
# hanya menentukan apakah ia juga dikirim sebagai surel.
#
# Alamat tujuan per kabupaten. Format "Kabupaten:alamat" dipisah koma.
# Sengaja kotak masuk INSTITUSI, bukan alamat pribadi pegawai: pegawai berganti,
# `pariwisata@tobakab.go.id` tidak. Kabupaten yang tidak tercantum jatuh ke
# daftar GOV_EMAILS.
# GOV_NOTIFIKASI_EMAILS=Toba:pariwisata@tobakab.go.id,Samosir:dpar@samosirkab.go.id

# SMTP memakai pustaka standar Python — tidak ada dependensi atau akun SaaS
# tambahan. Kosongkan seluruhnya bila tidak ingin mengirim surel sama sekali;
# notifikasi akan menumpuk berstatus ANTRE dan tetap terbaca di dashboard.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_DARI=noreply@tourcation.id
# SMTP_TLS=1


# --- Frontend (opsional, semuanya punya nilai bawaan) ------------------------
# Vite hanya membaca variabel berawalan VITE_ dan mencarinya di `frontend/.env`.
# Seluruh variabel di bawah boleh dikosongkan/dihapus — UI tetap tampil normal
# memakai nilai bawaan di frontend/src/config.ts.
#
# VITE_VIDEO_URL=https://youtu.be/xxxxxxxxxxx
# VITE_HERO_MEDIA_URL=https://youtu.be/xxxxxxxxxxx
# VITE_HERO_FOTO_URL=https://contoh.com/foto-hero.jpg
# VITE_BRAND_LOGO_URL=/logo.png
